<Window x:Class="Kadr.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Kadr.App.Controls"
        xmlns:vm="clr-namespace:Kadr.App.ViewModels"
        mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="Kadr" Width="960" Height="660" MinWidth="820" MinHeight="520"
        Background="White" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/kadr-app.ico">

    <TabControl x:Name="Tabs" Style="{StaticResource NavTabControl}">

        <!-- ================= Общие ================= -->
        <TabItem Header="Общие" Style="{StaticResource NavTabItem}">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="Общие настройки" Style="{StaticResource SectionHeader}" />
                <CheckBox Content="Запускать программу при старте Windows" IsChecked="{Binding AutostartOn}" />
                <CheckBox Content="Тихий режим работы программы" IsChecked="{Binding SilentMode}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Отключает звук, уведомления об успешных действиях, окна прогресса и вызов двумя кнопками мыши." />

                <TextBlock Text="Действие по клику в трее" Style="{StaticResource SubHeader}" />
                <ComboBox ItemsSource="{Binding TrayActions}" SelectedValuePath="Key" DisplayMemberPath="Value"
                          SelectedValue="{Binding TrayLeftClickAction}" MinWidth="260" />
            </StackPanel>
        </TabItem>

        <!-- ================= Горячие клавиши ================= -->
        <TabItem Header="Горячие клавиши" Style="{StaticResource NavTabItem}">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="Горячие клавиши" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="240" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" /><RowDefinition Height="46" /><RowDefinition Height="46" />
                        <RowDefinition Height="46" /><RowDefinition Height="46" /><RowDefinition Height="46" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Скриншот области экрана" Style="{StaticResource Label}" />
                    <c:HotkeyBox Grid.Row="0" Grid.Column="1" Hotkey="{Binding HotkeyRegion}" />
                    <TextBlock Grid.Row="1" Text="Скриншот активного окна" Style="{StaticResource Label}" />
                    <c:HotkeyBox Grid.Row="1" Grid.Column="1" Hotkey="{Binding HotkeyActiveWindow}" />
                    <TextBlock Grid.Row="2" Text="Скриншот активного монитора" Style="{StaticResource Label}" />
                    <c:HotkeyBox Grid.Row="2" Grid.Column="1" Hotkey="{Binding HotkeyActiveMonitor}" />
                    <TextBlock Grid.Row="3" Text="Скриншот рабочего стола" Style="{StaticResource Label}" />
                    <c:HotkeyBox Grid.Row="3" Grid.Column="1" Hotkey="{Binding HotkeyDesktop}" />
                    <TextBlock Grid.Row="4" Text="Запись/Стоп видео" Style="{StaticResource Label}" />
                    <c:HotkeyBox Grid.Row="4" Grid.Column="1" Hotkey="{Binding HotkeyVideo}" />
                    <TextBlock Grid.Row="5" Text="Пауза видео" Style="{StaticResource Label}" />
                    <c:HotkeyBox Grid.Row="5" Grid.Column="1" Hotkey="{Binding HotkeyPause}" />
                </Grid>
                <CheckBox Margin="0,16,0,10" Content="Две кнопки мыши одновременно для скриншота" IsChecked="{Binding UseMouseButtonsForScreenshot}" />
                <CheckBox Content="Ctrl + Shift + две кнопки мыши одновременно для видео" IsChecked="{Binding UseMouseButtonsForVideo}" />
                <TextBlock Style="{StaticResource Hint}" Text="Kadr перехватывает клавиши раньше других программ, поэтому занятые сочетания вроде PrtScr тоже работают. В тихом режиме вызов кнопками мыши отключён." />

                <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="6" Background="#FFF6E5" BorderBrush="#F6A623" BorderThickness="1"
                        Visibility="{Binding PrintScreenTakenBySystem, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                                   Text="В Windows клавиша PrtScr назначена на «Ножницы». Kadr забирает её себе, но можно отключить системный перехват совсем." />
                        <Button Content="Отключить перехват PrtScr" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding DisableSystemPrintScreenCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </TabItem>

        <!-- ================= Скриншоты ================= -->
        <TabItem Header="Скриншоты" Style="{StaticResource NavTabItem}">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="Куда сохранять скриншоты" Style="{StaticResource SectionHeader}" />
                <CheckBox Content="Сохранять скриншот на компьютер" IsChecked="{Binding SaveToFile}" />
                <CheckBox Content="Копировать скриншот в буфер обмена" IsChecked="{Binding CopyToClipboard}" />

                <Grid Margin="0,6,0,0" IsEnabled="{Binding SaveToFile}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Папка" Style="{StaticResource Label}" Margin="0,0,12,10" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ScreenshotsPath, UpdateSourceTrigger=LostFocus}" />
                    <Button Grid.Row="0" Grid.Column="2" Content="Обзор…" Style="{StaticResource FlatButton}" Margin="8,0,0,10"
                            Command="{Binding BrowseScreenshotsFolderCommand}" />
                    <TextBlock Grid.Row="1" Text="Имя файла" Style="{StaticResource Label}" Margin="0,0,12,10" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScreenshotFileNameTemplate, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Сбросить" Style="{StaticResource FlatButton}" Margin="8,0,0,10"
                            Command="{Binding ResetTemplateCommand}" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                        <TextBlock Text="{Binding TemplateError}" Foreground="{StaticResource RecordBrush}" FontSize="12" Margin="0,-4,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="Подстановки: {YYYY} {MM} {DD} {hh} {mm} {ss}, {w} заголовок окна, {n} {nn} {nnn} порядковый номер." />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Формат и качество" Style="{StaticResource SubHeader}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Сохранять в формате" Style="{StaticResource Label}" Margin="0,0,12,10" />
                    <ComboBox ItemsSource="{Binding FileTypes}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding ScreenshotFileType}" MinWidth="120" />
                    <TextBlock Text="Качество JPEG" Style="{StaticResource Label}" Margin="24,0,12,10" Visibility="{Binding IsJpeg, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox ItemsSource="{Binding JpegQualities}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding JpegQuality}" MinWidth="80"
                              Visibility="{Binding IsJpeg, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock Text="Редактор" Style="{StaticResource SubHeader}" />
                <CheckBox Content="Всегда активировать редактор" IsChecked="{Binding ShowEditor}" />
                <CheckBox Content="Рисовать тени объектов" IsChecked="{Binding DrawObjectShadows}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Элемент редактора по умолчанию" Style="{StaticResource Label}" Margin="0,0,12,10" />
                    <ComboBox ItemsSource="{Binding EditorDefaults}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding EditorDefaultElement}" MinWidth="240" />
                </StackPanel>

                <TextBlock Text="Прочее" Style="{StaticResource SubHeader}" />
                <CheckBox Content="Показывать курсор мыши" IsChecked="{Binding CaptureCursor}" />
                <CheckBox Content="Запоминать выделенную область" IsChecked="{Binding UsePreviouslySelectedRegion}" />
                <CheckBox Content="Проигрывать звук" IsChecked="{Binding PlaySound}" />
                <StackPanel Orientation="Horizontal" Margin="26,0,0,10" IsEnabled="{Binding PlaySound}">
                    <TextBlock Text="Звук затвора" Style="{StaticResource Label}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ShutterSoundDisplay}" VerticalAlignment="Center" MinWidth="150"
                               Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                    <Button Content="Обзор…" Style="{StaticResource FlatButton}" Margin="10,0,0,0"
                            Command="{Binding BrowseSoundCommand}" CommandParameter="shutter" />
                    <Button Content="Прослушать" Style="{StaticResource FlatButton}" Margin="0"
                            Command="{Binding TestSoundCommand}" CommandParameter="shutter" />
                    <Button Content="Сброс" Style="{StaticResource FlatButton}" Margin="0"
                            Command="{Binding ClearSoundCommand}" CommandParameter="shutter" />
                </StackPanel>
                <CheckBox Content="Открывать файл после сохранения" IsChecked="{Binding OpenFileAfterSave}" />
            </StackPanel>
        </TabItem>

        <!-- ================= Видео ================= -->
        <TabItem Header="Видео" Style="{StaticResource NavTabItem}">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="Куда сохранять видео" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Папка" Style="{StaticResource Label}" Margin="0,0,12,10" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VideoSavePath, UpdateSourceTrigger=LostFocus}" />
                    <Button Grid.Row="0" Grid.Column="2" Content="Обзор…" Style="{StaticResource FlatButton}" Margin="8,0,0,10" Command="{Binding BrowseVideoFolderCommand}" />
                    <TextBlock Grid.Row="1" Text="Имя файла" Style="{StaticResource Label}" Margin="0,0,12,10" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VideoFileNameTemplate, UpdateSourceTrigger=LostFocus}" />
                </Grid>

                <TextBlock Text="Качество записи" Style="{StaticResource SubHeader}" />
                <ComboBox ItemsSource="{Binding VideoQualities}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding VideoQualityLevel}" MinWidth="300" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Максимальная длительность, минут" Style="{StaticResource Label}" Margin="0,0,12,10" />
                    <TextBox Text="{Binding MaxVideoDurationMinutes, UpdateSourceTrigger=LostFocus}" Width="80" />
                </StackPanel>

                <TextBlock Text="Источники звука" Style="{StaticResource SubHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Микрофон" Style="{StaticResource Label}" Margin="0,0,12,10" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding MicrophoneDevices}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding InputAudioDeviceId}" MinWidth="320" />
                    <TextBlock Grid.Row="1" Text="Системный звук" Style="{StaticResource Label}" Margin="0,0,12,10" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SystemAudioDevices}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding OutputAudioDeviceId}" MinWidth="320" />
                    <TextBlock Grid.Row="2" Text="Веб-камера" Style="{StaticResource Label}" Margin="0,0,12,10" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CameraDevices}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding CameraDeviceId}" MinWidth="320" />
                </Grid>

                <TextBlock Text="Прочее" Style="{StaticResource SubHeader}" />
                <CheckBox Content="Показывать курсор мыши" IsChecked="{Binding CaptureCursorVideo}" />
                <CheckBox Content="Показывать подсветку курсора мыши" IsChecked="{Binding HighlightMousePointer}" />
                <CheckBox Content="Показывать подсветку кликов мыши" IsChecked="{Binding HighlightMouseClicks}" />
                <CheckBox Content="Показывать панель управления во время записи" IsChecked="{Binding ShowVideoControlPanel}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Звук начала записи" Style="{StaticResource Label}" Margin="0,0,12,0" MinWidth="150" />
                    <TextBlock Text="{Binding RecordStartSoundDisplay}" VerticalAlignment="Center" MinWidth="140"
                               Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                    <Button Content="Обзор…" Style="{StaticResource FlatButton}" Margin="10,0,0,0" Command="{Binding BrowseSoundCommand}" CommandParameter="start" />
                    <Button Content="Прослушать" Style="{StaticResource FlatButton}" Margin="0" Command="{Binding TestSoundCommand}" CommandParameter="start" />
                    <Button Content="Сброс" Style="{StaticResource FlatButton}" Margin="0" Command="{Binding ClearSoundCommand}" CommandParameter="start" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Звук конца записи" Style="{StaticResource Label}" Margin="0,0,12,0" MinWidth="150" />
                    <TextBlock Text="{Binding RecordStopSoundDisplay}" VerticalAlignment="Center" MinWidth="140"
                               Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                    <Button Content="Обзор…" Style="{StaticResource FlatButton}" Margin="10,0,0,0" Command="{Binding BrowseSoundCommand}" CommandParameter="stop" />
                    <Button Content="Прослушать" Style="{StaticResource FlatButton}" Margin="0" Command="{Binding TestSoundCommand}" CommandParameter="stop" />
                    <Button Content="Сброс" Style="{StaticResource FlatButton}" Margin="0" Command="{Binding ClearSoundCommand}" CommandParameter="stop" />
                </StackPanel>
                <CheckBox Content="Начинать запись сразу после выделения области" IsChecked="{Binding StartRecordingImmediately}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Окно камеры можно перетаскивать внутри области, менять размер за правый нижний угол; двойной клик меняет форму." />
            </StackPanel>
        </TabItem>

        <!-- ================= О программе ================= -->
        <TabItem Header="О программе" Style="{StaticResource NavTabItem}">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Image Source="pack://application:,,,/Assets/kadr-app.ico" Width="48" Height="48" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Version}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Скриншоты и запись экрана. Бесплатно, для личного использования
                                   ." Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Файлы программы" Style="{StaticResource SubHeader}" />
                <TextBlock Text="{Binding SettingsFile}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Открыть папку логов" Style="{StaticResource FlatButton}" Command="{Binding OpenLogFolderCommand}" />
                    <Button Content="Открыть папку данных" Style="{StaticResource FlatButton}" Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>
                <TextBlock Text="Windows 10 (сборка 19041 и новее) и Windows 11, .NET 8." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                <TextBlock Text="Лицензия" Style="{StaticResource SubHeader}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0"
                           Text="© Mike Alimov. Kadr распространяется по лицензии PolyForm Noncommercial 1.0.0: только для некоммерческого использования, без гарантий. Сторонние библиотеки: CommunityToolkit.Mvvm, H.NotifyIcon, Microsoft.Extensions, NAudio, Vortice.Windows (MIT), NLog (BSD-3-Clause). Кодеки, OCR и захват экрана предоставляет Windows. Kadr — независимая реализация, не связанная с программой «Скриншотер» и её разработчиком." />
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
