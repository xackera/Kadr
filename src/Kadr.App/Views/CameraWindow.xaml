<Window x:Class="Kadr.App.Views.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kadr" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False" Cursor="SizeAll">
    <Grid x:Name="Root">
        <Border x:Name="Shape" Background="#202020" BorderBrush="White" BorderThickness="3" CornerRadius="14" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" />
            </Border.Effect>
            <Grid>
                <Grid.Clip>
                    <RectangleGeometry x:Name="ClipGeometry" RadiusX="12" RadiusY="12" />
                </Grid.Clip>
                <Image x:Name="Preview" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality" />
                <TextBlock x:Name="Status" Text="Камера…" Foreground="White" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="10" />
            </Grid>
        </Border>
        <Thumb x:Name="ResizeGrip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0.01" DragDelta="ResizeGrip_DragDelta" />
    </Grid>
</Window>
