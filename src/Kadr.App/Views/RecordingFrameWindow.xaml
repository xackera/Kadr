<Window x:Class="Kadr.App.Views.RecordingFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kadr" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False" IsHitTestVisible="False">
    <Grid>
        <Rectangle x:Name="Outer" Stroke="#FF3B30" StrokeThickness="2" Margin="1" />
        <Rectangle x:Name="Inner" Stroke="White" StrokeThickness="1" StrokeDashArray="4 3" Margin="2.5" />
    </Grid>
</Window>
