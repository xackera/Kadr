<?xml version="1.0" encoding="utf-8"?>
<!--
  Установщик Kadr. Самодостаточная сборка: среда .NET внутри, на машине пользователя ничего ставить не нужно.
  Сборка: installer\build.ps1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?define ProductName = "Kadr" ?>
  <?define Manufacturer = "Mike Alimov" ?>

  <Package Name="$(ProductName)"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           UpgradeCode="868acd02-39ac-4364-86ae-211517dc6b5b"
           Scope="perMachine"
           Compressed="yes"
           Language="1049"
           Codepage="1251">

    <SummaryInformation Description="Kadr — скриншоты и запись экрана" Manufacturer="$(Manufacturer)" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="На компьютере уже установлена более новая версия Kadr." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!--
      Kadr требует Windows 10 сборки 19041: там появился нужный захват экрана.
      Свойства VersionNT и WindowsBuild для этого непригодны: Windows Installer по-прежнему
      сообщает из них версию 8.1, поэтому читаем настоящую версию из реестра.
      CurrentMajorVersionNumber есть только начиная с Windows 10, а номера сборок
      Windows 10 и 11 пятизначные, поэтому их корректно сравнивать как строки.
    -->
    <Property Id="WINMAJOR">
      <RegistrySearch Id="SearchWinMajor" Root="HKLM" Bitness="always64"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentMajorVersionNumber" Type="raw" />
    </Property>
    <Property Id="WINBUILD">
      <RegistrySearch Id="SearchWinBuild" Root="HKLM" Bitness="always64"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" />
    </Property>

    <Launch Condition="Installed OR (WINMAJOR AND WINBUILD &gt;= &quot;19041&quot;)"
            Message="Для Kadr нужна Windows 10 версии 2004 (сборка 19041) или новее." />

    <!-- Перед установкой и удалением закрываем работающую программу -->
    <util:CloseApplication Id="CloseKadr" Target="Kadr.exe" CloseMessage="yes" RebootPrompt="no" Timeout="5" />
    <util:CloseApplication Id="CloseRecorder" Target="Kadr.Recorder.exe" CloseMessage="yes" RebootPrompt="no" Timeout="5" />

    <Icon Id="KadrIcon" SourceFile="$(PublishDir)\Kadr.exe" />
    <Property Id="ARPPRODUCTICON" Value="KadrIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/xackera/Kadr" />

    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)license.rtf" />

    <!-- Мастер: выбор папки, страница с дополнительными задачами, запуск программы в конце -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Запустить Kadr" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <SetProperty Id="WixShellExecTarget" Value="[INSTALLFOLDER]Kadr.exe" After="CostFinalize" Sequence="ui" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_X64" />

    <UI>
      <!-- Своя страница с дополнительными задачами между выбором папки и подтверждением -->
      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="[ProductName]">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="260" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Дополнительные задачи" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Выберите, что сделать после установки" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="DesktopCheckBox" Type="CheckBox" X="20" Y="80" Width="330" Height="17"
                 Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="Создать ярлык на рабочем столе" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Вставляем страницу в последовательность мастера -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="10" Condition="1" />
      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="10" Condition="1" />
      <Publish Dialog="ShortcutsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="10" Condition="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="10" Condition="NOT Installed" />

      <!-- Кнопка «Готово» запускает программу, если галочка отмечена -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(ProductName)" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Kadr" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <!-- Все файлы самодостаточной сборки -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="6b5a1d2e-0c4f-4a5e-9d3b-7f2c18e4a911">
        <Shortcut Id="KadrStartMenu"
                  Name="Kadr"
                  Description="Скриншоты и запись экрана"
                  Target="[INSTALLFOLDER]Kadr.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\$(Manufacturer)\$(ProductName)" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="2f8e6c14-9a37-4d51-b0c2-5e93a7d61b48"
                 Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="KadrDesktop"
                  Name="Kadr"
                  Description="Скриншоты и запись экрана"
                  Target="[INSTALLFOLDER]Kadr.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\$(Manufacturer)\$(ProductName)" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
